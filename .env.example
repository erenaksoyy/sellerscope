DATABASE_URL=postgres://user:pass@localhost:5432/trendpanel
# Entegrasyon testinin hedefi (npm test). Yoksa yerel DATABASE_URL kullanılır.
# TEST_DATABASE_URL=
JWT_SECRET=degistir-beni
CRON_TOKEN=degistir-beni
# Yalnız Apify ile çekilen pazaryerleri için (ücretli; docs/cron.md).
# Amazon ABD/Almanya listeleri doğrudan çekilir, token gerekmez.
APIFY_TOKEN=apify_api_BURAYA_KENDI_TOKENINI_YAZ
# REAL_FETCH=1 olunca gerçek veri çekilir. Tanımsızken mock.
# REAL_FETCH=
# Türkiye karşılaştırmasının yapay zekâ katmanı (ikisi de ücretsiz katman).
# Gemini: aistudio.google.com, NVIDIA: build.nvidia.com/settings/api-keys.
# Biri yeterli; ikisi de yoksa yalnız kural katmanı çalışır. Doğrulama: npm run llm:check
GEMINI_API_KEY=
NVIDIA_API_KEY=
# Model zincirleri ("sağlayıcı:model", virgüllü, soldan sağa denenir; worker/config.js):
# LLM_QUERY_MODELS=gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite,nvidia:z-ai/glm-5.3
# LLM_JUDGE_MODELS=nvidia:nvidia/nemotron-3-super-120b-a12b,nvidia:z-ai/glm-5.3,gemini:gemini-3.5-flash-lite,gemini:gemini-3.1-flash-lite
# Haftalık özet e-postası (Resend). Yoksa digest gönderilemez.
RESEND_API_KEY=
EMAIL_FROM=SellerScope <ozet@orneksite.com>
